.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
#!.yarn/cache
node_modules
.hvigor/
.pnp.*

# CNG/Hvigor outputs
**/harmony/**/.cxx/
**/harmony/**/build/
**/harmony/**/oh_modules/
**/harmony/library/BuildProfile.ets
oh-package-lock.json5

# Harmony package artifacts.
*.har
*.hap
*.app
*.hsp

# Generated Expo state and native projects at an app root. This deliberately
# does not match app-local module sources under apps/*/modules/*/harmony.
apps/*/.expo/
apps/*/harmony/

# Signing keys, certificates, and provisioning profiles must remain external.
*.cer
*.crt
*.der
*.jks
*.key
*.keystore
*.mobileprovision
*.p12
*.p7b
*.p7c
*.p8
*.pem
*.pfx
*.pkcs12
*.profile
*.provisionprofile
