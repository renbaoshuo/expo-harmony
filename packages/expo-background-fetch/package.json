{
  "name": "@expo-harmony/expo-background-fetch",
  "version": "55.0.16-harmony.0",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-background-fetch"
  },
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-background-fetch#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "cd harmony && hvigorw --mode module -p module=expo_background_fetch@default -p product=default -p buildMode=release --no-daemon clean",
    "harmony:build": "cd harmony && hvigorw --mode module -p module=expo_background_fetch@default -p product=default -p buildMode=release --no-daemon assembleHar && mv -f library/build/default/outputs/default/expo_background_fetch.har ."
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo-harmony/expo-task-manager": "workspace:*",
    "@expo/config-plugins": "55.0.10"
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo-background-fetch": "55.0.16",
    "expo-task-manager": "~55.0.16"
  },
  "devDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@react-native-oh/react-native-harmony": "0.84.1",
    "expo": "55.0.26",
    "expo-background-fetch": "55.0.16",
    "expo-modules-core": "55.0.25",
    "expo-task-manager": "~55.0.16",
    "react": "19.2.3",
    "react-native": "0.84.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "autolinking": {
      "mainHarPath": "harmony",
      "ohPackageName": "@expo-harmony/expo-background-fetch",
      "etsPackageClassName": "ExpoBackgroundFetchPackage",
      "cppPackageClassName": "ExpoHarmonyExpoBackgroundFetchPackage",
      "cmakeLibraryTargetName": "expo_harmony__expo_background_fetch"
    }
  }
}
