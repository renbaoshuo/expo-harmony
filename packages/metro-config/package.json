  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/metro-config"
  },
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/metro-config#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "main": "index.js",
