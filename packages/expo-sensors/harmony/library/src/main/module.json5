{
  "module": {
    "name": "expo_sensors",
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.ACCELEROMETER"
      },
      {
        "name": "ohos.permission.GYROSCOPE"
      },
      {
        "name": "ohos.permission.ACTIVITY_MOTION",
        "reason": "$string:expo_sensors_motion_permission_reason",
        "usedScene": {
          "when": "inuse"
        }
      }
    ]
  }
}
