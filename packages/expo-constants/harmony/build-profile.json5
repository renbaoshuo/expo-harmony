{
  "app": {
    "products": [{
      "name": "default",
      "compatibleSdkVersion": "5.0.2(14)",
      "targetSdkVersion": "6.1.1(24)",
      "runtimeOS": "HarmonyOS"
    }],
    "buildModeSet": [{ "name": "debug" }, { "name": "release" }]
  },
  "modules": [{
    "name": "expo_constants",
    "srcPath": "./library",
    "targets": [{ "name": "default", "applyToProducts": ["default"] }]
  }]
}
