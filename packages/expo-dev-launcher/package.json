{
  "name": "@expo-harmony/expo-dev-launcher",
  "version": "57.0.21-harmony.0",
  "description": "HarmonyOS port of expo-dev-launcher",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "author": "Baoshuo <i@baoshuo.ren>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-dev-launcher"
  },
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-dev-launcher#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "expo-harmony-module prepare --clean-only",
    "harmony:build": "expo-harmony-module prepare",
    "prepack": "expo-harmony-module prepack"
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo-dev-launcher": "57.0.21"
  },
  "devDependencies": {
    "@expo-harmony/expo-module-scripts": "workspace:*",
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@react-native-oh/react-native-harmony": "0.86.1",
    "expo": "57.0.31",
    "expo-dev-launcher": "57.0.21",
    "expo-modules-core": "57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo-harmony/expo-dev-menu": "workspace:*",
    "@expo-harmony/expo-dev-menu-interface": "workspace:*",
    "@expo-harmony/expo-manifests": "workspace:*",
    "@expo-harmony/expo-updates-interface": "workspace:*",
    "@expo/config-plugins": "57.0.11"
  },
  "harmony": {
    "autolinking": {
      "mainHarPath": "harmony",
      "ohPackageName": "@expo-harmony/expo-dev-launcher",
      "etsPackageClassName": "ExpoDevLauncherPackage",
      "etsPackageImport": "named",
      "cppPackageClassName": "ExpoDevLauncherPackage",
      "cmakeLibraryTargetName": "expo_harmony__expo_dev_launcher"
    }
