{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "build",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "bin/**/*.ts",
    "index.ts",
    "src/**/*.ts"
  ],
  "exclude": ["build"]
}
