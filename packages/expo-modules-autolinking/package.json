{
  "name": "@expo-harmony/expo-modules-autolinking",
  "version": "57.0.16-harmony.0",
  "description": "HarmonyOS port of expo-modules-autolinking",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "author": "Baoshuo <i@baoshuo.ren>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-modules-autolinking"
  },
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-modules-autolinking#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "yarn build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "default": "./build/index.js"
    },
    "./tool-command": {
      "types": "./build/src/utilities/toolCommand.d.ts",
      "default": "./build/src/utilities/toolCommand.js"
    },
    "./harmony-module.schema.json": {
      "default": "./harmony-module.schema.json"
    },
    "./runtime": {
      "types": "./build/runtime.d.ts",
      "default": "./build/runtime.js"
    },
    "./runtime-source": "./runtime.ts",
    "./har": {
      "types": "./build/src/harmony/har.d.ts",
      "default": "./build/src/harmony/har.js"
    },
    "./native-inputs": {
      "types": "./build/src/harmony/nativeInputs.d.ts",
      "require": "./build/src/harmony/nativeInputs.js",
      "default": "./build/src/harmony/nativeInputs.js"
    }
  },
  "bin": {
    "expo-harmony-autolinking": "build/bin/expo-harmony-autolinking.js"
  },
  "dependencies": {
    "@expo-harmony/expo__config": "workspace:*",
    "@expo/config": "57.0.10",
    "@react-native-community/cli": "15.1.3",
    "@react-native-oh/react-native-harmony-cli": "0.86.1",
    "case": "1.6.3",
    "commander": "7.2.0",
    "cross-spawn": "^7.0.6",
    "expo-modules-autolinking": "57.0.16",
    "json5": "2.2.3",
    "metro": "0.84.3",
    "tar": "7.5.22",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.14.0"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
