{
  "name": "@expo-harmony/expo-modules-core",
  "version": "55.0.25-harmony.0",
  "description": "HarmonyOS native runtime for Expo Modules Core",
  "keywords": [
    "expo",
    "harmonyos",
    "react-native",
    "rnoh"
  ],
  "author": "Baoshuo <i@baoshuo.ren>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-modules-core"
  },
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-modules-core#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "cd harmony && hvigorw --mode module -p module=expo_modules_core@default -p product=default -p buildMode=release --no-daemon clean",
    "harmony:build": "cd harmony && hvigorw --mode module -p module=expo_modules_core@default -p product=default -p buildMode=release --no-daemon assembleHar && mv -f library/build/default/outputs/default/expo_modules_core.har ."
  },
  "peerDependencies": {
    "@react-native-oh/react-native-harmony": "0.84.1",
    "@react-native-ohos/react-native-worklets": "1.0.0",
    "expo-modules-core": "55.0.25",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@react-native-oh/react-native-harmony": "0.84.1",
    "@react-native-ohos/react-native-worklets": "1.0.0",
    "expo-modules-core": "55.0.25",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-worklets": "0.7.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "autolinking": {
      "mainHarPath": "harmony",
      "ohPackageName": "@expo-harmony/expo-modules-core",
      "etsPackageClassName": "ExpoModulesCorePackage",
      "cppPackageClassName": "ExpoModulesCorePackage",
      "cmakeLibraryTargetName": "expo_harmony__expo_modules_core"
    }
  }
}
