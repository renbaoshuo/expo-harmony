{
  "name": "@expo-harmony/expo-sharing",
  "version": "57.0.24-harmony.0",
  "description": "HarmonyOS port of expo-sharing",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-sharing#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-sharing"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "expo-harmony-module prepare --clean-only",
    "harmony:build": "expo-harmony-module prepare",
    "prepack": "expo-harmony-module prepack",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo/config-plugins": "~57.0.11"
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo-modules-core": "~57.0.24",
    "expo-sharing": "~57.0.24",
    "react": "^19.2.0",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo-harmony/expo-module-scripts": "workspace:*",
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@types/react": "19.2.2",
    "expo": "~57.0.31",
    "expo-modules-core": "~57.0.24",
    "expo-sharing": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "metro": {
      "redirects": [
        {
          "upstream": "expo-sharing",
          "origin": "build/index.js",
          "request": "./useIncomingShare",
          "target": "src/useIncomingShare.ts"
        }
      ]
    }
  }
}
