{
  "name": "@expo-harmony/expo-symbols",
  "version": "57.0.3-harmony.0",
  "description": "HarmonyOS port of expo-symbols",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-symbols#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-symbols"
  },
  "main": "index.js",
  "react-native": "src/index.ts",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./index.js"
    },
    "./src": "./src/index.ts",
    "./androidWeights/*": "./src/androidWeights/*.ts"
  },
  "scripts": {
    "harmony:clean": "expo-harmony-module prepare --clean-only",
    "harmony:build": "expo-harmony-module prepare",
    "prepack": "expo-harmony-module prepack",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo": "~57.0.31",
    "expo-modules-core": "~57.0.24",
    "expo-symbols": "~57.0.3",
    "react": "^19.2.0",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo-harmony/expo-module-scripts": "workspace:*",
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@types/react": "19.2.2",
    "expo": "~57.0.31",
    "expo-font": "~57.0.4",
    "expo-modules-core": "~57.0.24",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "metro": {
      "entrypoints": [
        {
          "upstream": "expo-symbols",
          "target": "src/index.ts"
        }
      ]
    }
  }
}
