{
  "name": "@expo-harmony/expo-app-metrics",
  "version": "0.2.2-harmony.0",
  "description": "HarmonyOS native implementation for expo-app-metrics",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-app-metrics"
  },
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-app-metrics#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "cd harmony && hvigorw --mode module -p module=expo_app_metrics@default -p product=default -p buildMode=release --no-daemon clean",
    "harmony:build": "cd harmony && hvigorw --mode module -p module=expo_app_metrics@default -p product=default -p buildMode=release --no-daemon assembleHar && mv -f library/build/default/outputs/default/expo_app_metrics.har ."
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo-app-metrics": "0.2.2"
  },
  "devDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@react-native-oh/react-native-harmony": "0.84.1",
    "expo": "55.0.26",
    "expo-app-metrics": "0.2.2",
    "expo-modules-core": "55.0.25",
    "react": "19.2.3",
    "react-native": "0.84.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "autolinking": {
      "mainHarPath": "harmony",
      "ohPackageName": "@expo-harmony/expo-app-metrics",
      "etsPackageClassName": "ExpoAppMetricsPackage",
      "cppPackageClassName": "ExpoHarmonyExpoAppMetricsPackage",
      "cmakeLibraryTargetName": "expo_harmony__expo_app_metrics"
    }
  }
}
