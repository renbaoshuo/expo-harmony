+  const padding: ViewStyle = {};
+  for (const edge of ['top', 'right', 'bottom', 'left'] as const) {
+    if (!edges?.[edge] || insets[edge] === 0) continue;
+    const key = `padding${edge[0].toUpperCase()}${edge.slice(1)}` as
+      | 'paddingTop'
+      | 'paddingRight'
+      | 'paddingBottom'
+      | 'paddingLeft';
+    const horizontal = edge === 'left' || edge === 'right';
+    const logical =
+      edge === (I18nManager.isRTL ? 'right' : 'left')
+        ? flattened.paddingStart
+        : flattened.paddingEnd;
+    const value =
+      (horizontal ? logical : undefined) ??
+      flattened[key] ??
+      (horizontal ? flattened.paddingHorizontal : flattened.paddingVertical) ??
+      flattened.padding ??
+      0;
+    const amount =
+      typeof value === 'number'
+        ? value
+        : typeof value === 'string' && value.endsWith('%')
