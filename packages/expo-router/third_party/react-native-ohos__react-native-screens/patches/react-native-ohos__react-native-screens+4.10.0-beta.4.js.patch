+import type {NativeSyntheticEvent} from 'react-native';
+
+// Components implemented using Harmony's RN primitives still expose the same
+// event shape as their native counterparts.
+export function makeEvent<T>(nativeEvent: T): NativeSyntheticEvent<T> {
+  return {
+    nativeEvent,
+    timeStamp: Date.now(),
+    currentTarget: 0,
+    target: 0,
+    bubbles: false,
+    cancelable: false,
+    defaultPrevented: false,
+    eventPhase: 2,
+    isTrusted: false,
+    type: 'screens',
+    preventDefault() {},
+    stopPropagation() {},
+    isDefaultPrevented: () => false,
+    isPropagationStopped: () => false,
+    persist() {},
+  } as unknown as NativeSyntheticEvent<T>;
+}
