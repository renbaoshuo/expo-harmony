+// view below a native header therefore receives zero for its consumed top edge.
+export function SafeAreaView({
+  edges,
+  insetType: _insetType, // Upstream documents this selector as Android-only.
+  style,
+  ...props
+}: SafeAreaViewProps) {
+  const [width, setWidth] = React.useState(0);
+  const [insets, setInsets] = React.useState<Insets>({
+    top: 0,
+    right: 0,
+    bottom: 0,
+    left: 0,
+  });
