+  React.useEffect(() => {
+    if (phase.current === 'opening' || phase.current === 'open') {
+      settle(detentIndex, phase.current === 'open');
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [detentsKey]);
+  React.useEffect(
+    () => () => {
+      offset.stopAnimation();
+      sheetHeight.stopAnimation();
+    },
+    [offset, sheetHeight],
+  );
+
+  const pan = React.useMemo(
+    () =>
+      PanResponder.create({
+        onStartShouldSetPanResponder: () => true,
+        onPanResponderGrant: () => {
+          dragStart.current = currentHeight.current;
+        },
+        onPanResponderMove: (_event, gesture) => {
+          sheetHeight.setValue(
+            Math.max(
+              32,
+              Math.min(windowHeight, dragStart.current - gesture.dy),
+            ),
+          );
+        },
+        onPanResponderRelease: (_event, gesture) => {
+          const values = heights.current;
+          const target = dragStart.current - gesture.dy;
+          if (target < values[0] * 0.65 || gesture.vy > 1.5) close(true);
+          else
+            settle(
+              values.reduce(
+                (best, value, index) =>
+                  Math.abs(value - target) < Math.abs(values[best] - target)
+                    ? index
+                    : best,
+                0,
+              ),
+            );
+        },
+        onPanResponderTerminate: () => settle(detentIndex),
+      }),
+    [sheetHeight, windowHeight, close, settle, detentIndex],
+  );
+  const undimmed = props.largestUndimmedDetentIndex;
+  const dimmed =
+    undimmed !== 'last' &&
+    detentIndex > resolveLargestUndimmedDetentIndex(undimmed, detents.length);
+  const radius =
+    typeof props.preferredCornerRadius === 'number' &&
+    props.preferredCornerRadius >= 0
+      ? props.preferredCornerRadius
+      : 24;
+  return (
+    <Modal
+      visible={visible}
+      transparent
+      animationType="none"
+      onShow={() => {
+        if (latest.current.isOpen && phase.current === 'presenting') show();
+      }}
+      onRequestClose={() => close(true)}>
+      <View style={styles.window}>
+        <Pressable
+          accessibilityRole="button"
+          accessibilityLabel="Dismiss sheet"
+          style={[StyleSheet.absoluteFill, dimmed && styles.dim]}
+          onPress={() => close(true)}
+        />
+        <Animated.View style={{transform: [{translateY: offset}]}}>
+          <Animated.View
+            style={[
+              styles.sheet,
+              {
+                height: sheetHeight,
+                borderTopLeftRadius: radius,
+                borderTopRightRadius: radius,
+                backgroundColor:
+                  props.nativeContainerStyle?.backgroundColor ?? 'white',
+              },
+            ]}>
+            <View {...pan.panHandlers} style={styles.dragHandle}>
+              {props.prefersGrabberVisible && <View style={styles.grabber} />}
+            </View>
+            <View
+              style={!fitToContents && styles.content}
+              onLayout={
+                fitToContents
+                  ? event => {
