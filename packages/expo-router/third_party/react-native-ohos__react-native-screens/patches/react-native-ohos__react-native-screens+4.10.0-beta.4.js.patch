+'use client';
+
+import React from 'react';
+import {View} from 'react-native';
+import type {ScrollViewMarkerProps} from 'react-native-screens/src/components/gamma/scroll-view-marker';
+
+export type * from 'react-native-screens/src/components/gamma/scroll-view-marker';
+
+export function ScrollViewMarker({children, style}: ScrollViewMarkerProps) {
+  // UIScrollEdgeEffect is iOS 26-only. Keep the marker's layout and its direct
+  // scroll child on Harmony, without registering an unavailable UIKit view.
+  return (
+    <View collapsable={false} style={style}>
+      {children}
+    </View>
+  );
+}
