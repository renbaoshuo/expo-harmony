+'use client';
+
+import React from 'react';
+import {
+  Animated,
+  Modal,
+  PanResponder,
+  Pressable,
+  StyleSheet,
+  View,
+  useWindowDimensions,
+} from 'react-native';
+import type {FormSheetProps} from 'react-native-screens/src/components/gamma/modals/form-sheet';
+import {
+  resolveInitialDetentIndex,
+  resolveLargestUndimmedDetentIndex,
+} from 'react-native-screens/src/components/gamma/modals/form-sheet/FormSheetUtils';
+import {makeEvent} from '../../events';
+
+export type * from 'react-native-screens/src/components/gamma/modals/form-sheet';
+
+const DRAG_HANDLE_HEIGHT = 24;
+
+function getDetentFractions(detents: FormSheetProps['detents']): number[] {
+  if (!Array.isArray(detents) || detents.length === 0) return [1];
+  if (detents.some(value => !Number.isFinite(value) || value < 0 || value > 1)) {
+    console.error(
+      '[RNScreens] FormSheet detents must be in the range [0, 1]. Falling back to a full-height detent.',
+    );
+    return [1];
+  }
+  if (detents.some((value, index) => index > 0 && value <= detents[index - 1])) {
+    console.error(
+      '[RNScreens] FormSheet detents must be strictly ascending. Falling back to a full-height detent.',
+    );
+    return [1];
+  }
+  return detents;
+}
+
+// Use the Harmony RN Modal for window and back-button integration.
+export function FormSheet(props: FormSheetProps) {
+  const latest = React.useRef(props);
+  latest.current = props;
+  const {height: windowHeight} = useWindowDimensions();
+  const [visible, setVisible] = React.useState(false);
+  const [contentHeight, setContentHeight] = React.useState(0);
+  const [detentIndex, setDetentIndex] = React.useState(0);
+  const phase = React.useRef<'closed' | 'presenting' | 'opening' | 'open' | 'closing'>(
+    'closed',
+  );
+  const offset = React.useRef(new Animated.Value(windowHeight)).current;
+  const sheetHeight = React.useRef(new Animated.Value(windowHeight)).current;
+  const currentHeight = React.useRef(windowHeight);
+  const dragStart = React.useRef(windowHeight);
+  const reportedDetent = React.useRef<number | undefined>(undefined);
+  const fitToContents = props.detents === 'fitToContents';
+  const detentFractions = React.useMemo(
+    () => getDetentFractions(props.detents),
+    [props.detents],
+  );
+  const detents = fitToContents
+    ? [Math.min(windowHeight, contentHeight || windowHeight)]
+    : detentFractions.map(fraction => fraction * windowHeight);
+  const heights = React.useRef(detents);
+  heights.current = detents;
+
+  const settle = React.useCallback(
+    (index: number, animated = true) => {
+      const values = heights.current;
+      const bounded = Math.max(0, Math.min(values.length - 1, index));
+      currentHeight.current = values[bounded];
+      setDetentIndex(bounded);
+      Animated.timing(sheetHeight, {
+        toValue: values[bounded],
+        duration: animated ? 200 : 0,
+        useNativeDriver: false,
+      }).start();
+      if (reportedDetent.current !== bounded) {
+        reportedDetent.current = bounded;
+        latest.current.onDetentChanged?.(makeEvent({index: bounded}));
+      }
+    },
+    [sheetHeight],
+  );
+
+  const close = React.useCallback(
+    (native: boolean) => {
+      if (phase.current === 'closed' || phase.current === 'closing') return;
+      if (native && latest.current.preventNativeDismiss) {
+        latest.current.onNativeDismissPrevented?.(makeEvent({}));
+        settle(detentIndex);
+        return;
+      }
+      if (phase.current === 'presenting') {
+        phase.current = 'closed';
+        setVisible(false);
+        return;
+      }
+      phase.current = 'closing';
+      latest.current.onWillDisappear?.(makeEvent({}));
+      Animated.timing(offset, {
+        toValue: windowHeight,
+        duration: 220,
+        useNativeDriver: true,
+      }).start(({finished}) => {
+        if (!finished) return;
+        phase.current = 'closed';
+        setVisible(false);
+        latest.current.onDidDisappear?.(makeEvent({}));
+        (native ? latest.current.onNativeDismiss : latest.current.onDismiss)?.(
+          makeEvent({}),
+        );
+      });
+    },
+    [offset, windowHeight, settle, detentIndex],
+  );
+
+  const show = React.useCallback(() => {
+    phase.current = 'opening';
+    const initial = latest.current.initialDetentIndex;
+    const count = heights.current.length;
+    const index =
+      initial === 'last' ? count - 1 : resolveInitialDetentIndex(initial, count);
+    reportedDetent.current = undefined;
+    settle(index, false);
+    latest.current.onWillAppear?.(makeEvent({}));
+    Animated.timing(offset, {
+      toValue: 0,
+      duration: 220,
+      useNativeDriver: true,
+    }).start(({finished}) => {
+      if (!finished) return;
+      phase.current = 'open';
+      latest.current.onDidAppear?.(makeEvent({}));
+    });
+  }, [offset, settle]);
+
+  React.useEffect(() => {
+    if (props.isOpen) {
+      if (phase.current === 'closed') {
+        phase.current = 'presenting';
