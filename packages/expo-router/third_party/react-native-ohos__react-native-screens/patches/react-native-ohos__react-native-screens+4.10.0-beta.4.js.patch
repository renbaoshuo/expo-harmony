+                      );
+                    }
+                  : undefined
+              }>
+              {props.children}
+            </View>
+          </Animated.View>
+        </Animated.View>
+      </View>
+    </Modal>
+  );
+}
+
+const styles = StyleSheet.create({
+  window: {flex: 1, justifyContent: 'flex-end'},
+  dim: {backgroundColor: '#0006'},
+  sheet: {overflow: 'hidden'},
+  content: {flex: 1},
+  dragHandle: {height: DRAG_HANDLE_HEIGHT, alignItems: 'center', justifyContent: 'center'},
+  grabber: {width: 36, height: 5, borderRadius: 3, backgroundColor: '#888'},
+});
