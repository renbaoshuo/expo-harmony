+  private onWindowSizeChange = (_size: window.Size): void => this.refresh();
+  private onWindowStatusChange = (_status: window.WindowStatusType): void => this.refresh();
+
+  aboutToAppear(): void {
+    const appearance = ++this.appearance;
+    window.getLastWindow(this.ctx.uiAbilityContext).then((instance: window.Window) => {
+      if (this.appearance !== appearance) return;
+      this.windowInstance = instance;
+      instance.on('avoidAreaChange', this.onAvoidAreaChange);
+      instance.on('windowSizeChange', this.onWindowSizeChange);
+      instance.on('windowStatusChange', this.onWindowStatusChange);
+      this.refresh();
+    }).catch((error: Error) => {
+      if (this.appearance === appearance) this.ctx.logger.error('RNSSafeAreaView: ' + error);
+    });
+  }
+
+  aboutToDisappear(): void {
+    this.appearance++;
+    this.frame = undefined;
+    this.previous = '';
+    this.windowInstance?.off('avoidAreaChange', this.onAvoidAreaChange);
+    this.windowInstance?.off('windowSizeChange', this.onWindowSizeChange);
+    this.windowInstance?.off('windowStatusChange', this.onWindowStatusChange);
+    this.windowInstance = undefined;
+  }
+
+  private refresh(): void {
+    try {
+      this.readInsets();
+    } catch (error) {
+      this.ctx.logger.error('RNSSafeAreaView: failed to refresh insets: ' + error);
+    }
+  }
+
+  private readInsets(): void {
+    if (!this.windowInstance || !this.frame) return;
+    const properties = this.windowInstance.getWindowProperties();
+    const system = this.windowInstance.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM);
+    const cutout = this.windowInstance.getWindowAvoidArea(window.AvoidAreaType.TYPE_CUTOUT);
+    const indicator = this.windowInstance.getWindowAvoidArea(window.AvoidAreaType.TYPE_NAVIGATION_INDICATOR);
+    const x = Number(this.frame.globalPosition.x);
+    const y = Number(this.frame.globalPosition.y);
+    const width = Number(this.frame.width);
+    const height = Number(this.frame.height);
+    // ArkUI can place a view under system bars even in a non-fullscreen window.
+    // Its actual frame determines which edges have already been consumed.
+    const insets: EdgeInsets = {
+      top: Math.min(height, Math.max(0,
+        px2vp(Math.max(system.topRect.height, cutout.topRect.height, indicator.topRect.height)) - y)),
+      left: Math.min(width, Math.max(0,
+        px2vp(Math.max(system.leftRect.width, cutout.leftRect.width, indicator.leftRect.width)) - x)),
+      right: Math.min(width, Math.max(0, x + width - px2vp(properties.windowRect.width -
+        Math.max(system.rightRect.width, cutout.rightRect.width, indicator.rightRect.width)))),
+      bottom: Math.min(height, Math.max(0, y + height - px2vp(properties.windowRect.height -
+        Math.max(system.bottomRect.height, cutout.bottomRect.height, indicator.bottomRect.height)))),
+    };
+    const serialized = JSON.stringify(insets);
+    if (this.previous !== serialized) {
+      this.previous = serialized;
+      new RNC.RNSSafeAreaView.EventEmitter(this.ctx.rnInstance, this.tag).emit('insetsChange', insets);
+    }
+  }
+
+  build() {
+    Column() {}
+    .width('100%')
+    .height('100%')
+    .hitTestBehavior(HitTestMode.None)
+    .onAreaChange((_old: Area, area: Area) => {
+      this.frame = area;
+      this.refresh();
+    })
+  }
+}
