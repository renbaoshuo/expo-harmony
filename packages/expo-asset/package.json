{
  "name": "@expo-harmony/expo-asset",
  "version": "57.0.20-harmony.0",
  "description": "HarmonyOS port of expo-asset",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo-asset#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-asset"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "expo-harmony-module prepare --clean-only",
    "harmony:build": "expo-harmony-module prepare",
    "prepack": "expo-harmony-module prepare"
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo/config-plugins": "~57.0.11"
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo-asset": "~57.0.20"
  },
  "devDependencies": {
    "@expo-harmony/expo-module-scripts": "workspace:*",
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-modules-core": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "metro": {
      "redirects": [
        {
          "upstream": "expo-asset",
          "origin": "build/AssetSources.js",
          "request": "./AssetSourceResolver",
          "target": "src/AssetSourceResolver.js"
        }
      ]
    }
  }
}
