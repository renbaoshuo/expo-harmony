{
  "name": "@expo-harmony/cli",
  "version": "57.0.31-harmony.0",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/cli#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/cli"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "prebuild": "yarn workspace @expo-harmony/prebuild-config build",
    "build": "tsc -p tsconfig.json",
    "prepare": "yarn build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "default": "./build/index.js"
    },
    "./bin/expo-harmony": "./build/bin/expo-harmony.js",
    "./native-build": {
      "types": "./build/native/hvigor.d.ts",
      "require": "./build/native/hvigor.js",
      "default": "./build/native/hvigor.js"
    },
    "./internal/prebuild": {
      "types": "./build/internal/prebuild.d.ts",
      "require": "./build/internal/prebuild.js",
      "default": "./build/internal/prebuild.js"
    },
    "./internal/development": {
      "types": "./build/internal/development.d.ts",
      "require": "./build/internal/development.js",
      "default": "./build/internal/development.js"
    }
  },
  "bin": {
    "expo-harmony": "build/bin/expo-harmony.js"
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo-harmony/expo-build-properties": "workspace:*",
    "@expo-harmony/expo-modules-autolinking": "workspace:*",
    "@expo-harmony/expo__config": "workspace:*",
    "@expo-harmony/prebuild-config": "workspace:*",
    "@expo/config": "~57.0.10",
    "@expo/fingerprint": "~0.20.14",
    "cross-spawn": "^7.0.6",
    "json5": "2.2.3",
    "mime-types": "3.0.2",
    "minimatch": "^10.2.2"
  },
  "peerDependencies": {
    "expo": "~57.0.31"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/mime-types": "3.0.1",
    "@types/node": "22.14.0",
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
