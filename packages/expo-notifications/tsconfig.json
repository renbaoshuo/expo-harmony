{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "react"
    ]
  },
  "include": [
    "src/**/*.ts",
    "plugin/**/*.d.ts"
  ]
}
