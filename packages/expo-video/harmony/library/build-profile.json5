{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      "types": ["./src/main/ets/VideoMetadata"]
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "abiFilters": ["arm64-v8a", "x86_64"]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    }
  ]
}
