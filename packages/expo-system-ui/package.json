{
  "name": "@expo-harmony/expo-system-ui",
  "version": "55.0.18-harmony.0",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-system-ui"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "cd harmony && hvigorw --mode module -p module=expo_system_ui@default -p product=default -p buildMode=release --no-daemon clean",
    "harmony:build": "cd harmony && hvigorw --mode module -p module=expo_system_ui@default -p product=default -p buildMode=release --no-daemon assembleHar && mv -f library/build/default/outputs/default/expo_system_ui.har ."
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo/config-plugins": "55.0.10",
    "@react-native/normalize-colors": "0.84.1"
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo-system-ui": "55.0.18"
  },
  "devDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@react-native-oh/react-native-harmony": "0.84.1",
    "expo": "55.0.26",
    "expo-modules-core": "55.0.25",
    "expo-system-ui": "55.0.18",
    "react": "19.2.3",
    "react-native": "0.84.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "autolinking": {
      "mainHarPath": "harmony",
      "ohPackageName": "@expo-harmony/expo-system-ui",
      "etsPackageClassName": "ExpoSystemUIPackage",
      "cmakeLibraryTargetName": "expo_harmony__expo_system_ui"
    }
  }
}
