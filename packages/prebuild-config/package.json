{
  "name": "@expo-harmony/prebuild-config",
  "version": "55.0.0-harmony.7",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/prebuild-config#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/prebuild-config"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "prebuild": "yarn workspace @expo-harmony/config-plugins build && yarn workspace @expo-harmony/expo-modules-autolinking build",
    "build": "tsc -p tsconfig.json",
    "prepare": "yarn build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "default": "./build/index.js"
    },
    "./internal": {
      "types": "./build/internal.d.ts",
      "require": "./build/internal.js",
      "default": "./build/internal.js"
    },
    "./internal/template": {
      "types": "./build/api/template.d.ts",
      "require": "./build/api/template.js",
      "default": "./build/api/template.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo-harmony/expo-modules-autolinking": "workspace:*",
    "@expo-harmony/template": "workspace:*",
    "@expo/config": "55.0.17",
    "@expo/config-plugins": "55.0.10",
    "@react-native-community/cli-config": "15.1.3",
    "json5": "2.2.3"
  },
  "peerDependencies": {
    "expo": "55.0.26"
  },
  "devDependencies": {
    "@types/node": "18.19.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
