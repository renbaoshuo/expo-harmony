{
  "name": "@expo-harmony/config-plugins",
  "version": "57.0.10-harmony.0",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/config-plugins#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/config-plugins"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "yarn build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json",
    "./internal": {
      "types": "./build/internal.d.ts",
      "require": "./build/internal.js",
      "default": "./build/internal.js"
    }
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.11",
    "@expo/config-types": "~57.0.2",
    "@react-native/normalize-colors": "0.86.3",
    "json5": "2.2.3"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
