{
  "name": "@expo-harmony/expo-navigation-bar",
  "version": "55.0.13-harmony.0",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo-navigation-bar"
  },
  "main": "index.js",
  "react-native": "src/index.ts",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "cd harmony && hvigorw --mode module -p module=expo_navigation_bar@default -p product=default -p buildMode=release --no-daemon clean",
    "harmony:build": "cd harmony && hvigorw --mode module -p module=expo_navigation_bar@default -p product=default -p buildMode=release --no-daemon assembleHar && mv -f library/build/default/outputs/default/expo_navigation_bar.har .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@expo-harmony/config-plugins": "workspace:*",
    "@expo/config-plugins": "55.0.10",
    "@react-native/normalize-colors": "0.84.1"
  },
  "peerDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "expo-modules-core": "55.0.25",
    "expo-navigation-bar": "55.0.13",
    "react": "19.2.3",
    "react-native": "0.84.1"
  },
  "devDependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@react-native-oh/react-native-harmony": "0.84.1",
    "@types/react": "19.2.2",
    "expo": "55.0.26",
    "expo-modules-core": "55.0.25",
    "expo-navigation-bar": "55.0.13",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "harmony": {
    "alias": "expo-navigation-bar",
    "redirectInternalImports": true,
    "autolinking": {
      "mainHarPath": "harmony",
      "ohPackageName": "@expo-harmony/expo-navigation-bar",
      "etsPackageClassName": "ExpoNavigationBarPackage",
      "cmakeLibraryTargetName": "expo_harmony__expo_navigation_bar"
    }
  }
}
