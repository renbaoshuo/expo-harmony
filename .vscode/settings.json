{
  "files.exclude": {
    "**/oh_modules": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/oh_modules/**": true,
    "**/.hvigor/**": true,
    "**/.cxx/**": true,
    "**/build/**": true,
    "**/.expo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/oh_modules": true,
    "**/.hvigor": true,
    "**/.cxx": true,
    "**/build": true,
    "**/.expo": true
  },
  "eslint.format.enable": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderFinalNewline": "on",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json5]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "json.format.keepLines": true
}
