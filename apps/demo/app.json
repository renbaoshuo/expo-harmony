{
  "expo": {
    "name": "Expo Harmony 模块演示",
    "slug": "expo-harmony-demo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "scheme": "expoharmonydemo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "experiments": {
      "outOfTreePlatforms": true
    },
    "platforms": [
      "ios",
      "android",
      "harmony"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/AntDesign.ttf"
          ]
        }
      ],
      "@expo-harmony/expo-constants",
      "@expo-harmony/expo-notifications",
      "@expo-harmony/expo-font",
      [
        "@expo-harmony/expo-calendar",
        {
          "readCalendarPermission": "用于在示例中查看日历、日程和重复日程",
          "writeCalendarPermission": "用于在示例中创建、修改和删除日历及日程"
        }
      ],
      [
        "@expo-harmony/expo-contacts",
        {
          "readContactsPermission": "用于在示例中查找和导出联系人",
          "writeContactsPermission": "用于在示例中添加、修改和删除联系人"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/app-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "@expo-harmony/expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/app-icon.svg",
          "resizeMode": "contain"
        }
      ],
      "expo-system-ui",
      "@expo-harmony/expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "@expo-harmony/expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "@expo-harmony/expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许应用在使用期间获取位置，并在示例中查看地址"
        }
      ],
      "expo-sharing",
      "@expo-harmony/expo-sharing",
      "expo-background-fetch",
      "@expo-harmony/expo-background-fetch",
      "expo-background-task",
      "@expo-harmony/expo-background-task",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true
        }
      ],
      [
        "@expo-harmony/expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "@expo-harmony/expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      "./plugins/withAudioFixture",
      "./plugins/withIntentLauncherFixture",
      "./plugins/withOaidPermissionReason",
      "@expo-harmony/expo__log-box",
      "@expo-harmony/prebuild-config",
      [
        "@expo-harmony/expo-build-properties",
        {
          "harmony": {
            "compatibleSdkVersion": 23,
            "targetSdkVersion": 24
          }
        }
      ]
    ],
    "harmony": {
      "bundleName": "cn.baoshuo.expoharmony.demo",
      "label": "Expo Harmony 模块演示",
      "icon": "./assets/app-icon.svg",
      "versionCode": 1,
      "querySchemes": ["mailto"],
      "permissions": [
        {
          "name": "ohos.permission.CAMERA",
          "reason": "$string:camera_permission_reason",
          "usedScene": {
            "abilities": [
              "EntryAbility"
            ],
            "when": "inuse"
          }
        },
        {
          "name": "ohos.permission.MICROPHONE",
          "reason": "$string:microphone_permission_reason",
          "usedScene": {
            "abilities": [
              "EntryAbility"
            ],
            "when": "inuse"
          }
        },
        {
          "name": "ohos.permission.GET_NETWORK_INFO"
        },
        {
          "name": "ohos.permission.APP_TRACKING_CONSENT",
          "reason": "$string:expo_harmony_demo_oaid_permission_reason",
          "usedScene": {
            "abilities": ["EntryAbility"],
            "when": "inuse"
          }
        }
      ],
      "backgroundColor": "#F2F2F7",
      "userInterfaceStyle": "light"
    },
    "ios": {
      "bundleIdentifier": "cn.baoshuo.expoharmony.demo",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "package": "cn.baoshuo.expoharmony.demo"
    }
  }
}
