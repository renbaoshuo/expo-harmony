{
  "name": "expo-harmony",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git"
  },
  "homepage": "https://github.com/renbaoshuo/expo-harmony#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "author": "Baoshuo <i@baoshuo.ren>",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/*/modules/*"
  ],
  "scripts": {
    "build": "yarn harmony:build && yarn workspaces foreach --all --include '@expo-harmony/*' --topological-dev --verbose run build",
    "harmony:build": "node ./packages/expo-module-scripts/bin/expo-harmony-module.js build-workspace",
    "lint": "eslint \"{packages,apps}/*/**/*.{ts,tsx,js,jsx}\" --fix",
    "lint:check": "eslint \"{packages,apps}/*/**/*.{ts,tsx,js,jsx}\"",
    "release": "node scripts/release.mjs",
    "release:prepare": "node scripts/release.mjs --prepare-only"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "json5": "2.2.3",
    "semver": "7.7.3",
    "tar": "6.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.14.1"
}
